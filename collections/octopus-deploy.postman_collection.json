  "info": {
    "_postman_id": "61eab92a-87bb-4a0b-aba5-c45ddefb8d8b",
    "name": "Octopus Deploy REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Octopus Deploy REST API exposes 100% of the operations available\nin the Octopus UI for managing projects, environments, deployment\ntargets, releases, runbooks, and more. Responses are hypermedia\ndriven, so clients can navigate from the `/api` root. Endpoint\nscaffold derived from https://octopus.com/docs/octopus-rest-api and\nits getting-started guide.\n\n\nContact Support:\n Name: Octopus Deploy Documentation",
      "type": "text/plain"
    }
  }
