{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octopus Deploy REST Accounts Projects API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Octopus-ApiKey",
      "value": "{{X-Octopus-ApiKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List projects in the default space",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-octopus-instance/api/Spaces-1/projects"
          },
          "docs": "List projects in the default space"
        }
      ]
    }
  ],
  "bundled": true
}